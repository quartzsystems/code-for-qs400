    "free-tokens": {
      "patterns": [
        {
          "include": "#line-comment"
        },
        {
          "include": "#exec-sql"
        },
        {
          "include": "#strings"
        },
        {
          "match": "(?i)\\b(dcl-(?:s|c|ds|pr|pi|f|proc|subf|parm|enum)|end-(?:ds|pr|pi|proc|enum)|ctl-opt)\\b",
          "name": "storage.type.declaration.qs400-rpgle"
