            "1": {
              "name": "keyword.control.directive.include.qs400-rpgle"
            },
            "2": {
              "name": "string.unquoted.include.qs400-rpgle"
            }
          }
        },
        {
          "match": "(?i)(/(?:if|elseif))\\s+(not\\s+)?(defined)(\\s*\\()([^)]*)(\\))",
          "captures": {
            "1": {
              "name": "keyword.control.directive.conditional.qs400-rpgle"
            },
            "2": {
              "name": "keyword.operator.logical.qs400-rpgle"
            },
            "3": {
              "name": "support.function.directive.qs400-rpgle"
            },
