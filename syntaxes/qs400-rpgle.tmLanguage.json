    "strings": {
      "patterns": [
        {
          "begin": "(?i)[xgucz]?'",
          "end": "'(?!')",
          "name": "string.quoted.single.qs400-rpgle",
          "patterns": [
            {
              "match": "''",
              "name": "constant.character.escape.qs400-rpgle"
