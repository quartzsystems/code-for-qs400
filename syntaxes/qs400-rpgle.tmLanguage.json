          "include": "#free-statements"
        }
      ]
    },
    "fixed-sql": {
      "begin": "^((?>.{0,5}))([Cc])(/)((?i:exec)\\s+(?i:sql))\\b",
      "beginCaptures": {
        "1": {
          "name": "comment.block.sequence.qs400-rpgle"
