          "match": "(?i)(?<![\\w#@$-])(?:acq|bitoff|biton|cab|call|callb|cas|cat|chain|check|checkr|clear|close|comp|commit|dealloc|define|delete|div|do|dsply|dump|eval|evalr|eval-corr|except|exfmt|extrct|feod|force|in|kfld|klist|lookup|move|movea|movel|mult|mvr|next|occur|open|out|parm|plist|post|read|readc|reade|readp|readpe|realloc|rel|reset|rolbk|scan|setgt|setll|setoff|seton|shtdn|sorta|sqrt|sub|subdur|subst|tag|test|testb|testn|testz|time|unlock|update|write|xfoot|xlate|xml-into|xml-sax|data-into|data-gen|snd-msg|z-add|z-sub|add|adddur|alloc|end|endcs)(?:\\(\\s*[a-z ]*\\))?(?![\\w#@$-])",
          "name": "keyword.other.opcode.qs400-rpgle"
        },
        {
          "match": "(?i)(?<![\\w#@$-])(?:char|varchar|ucs2|varucs2|graph|vargraph|int|uns|packed|zoned|bindec|float|ind|date|time|timestamp|pointer|object|like|likeds|likerec|likefile|dim|qualified|template|inz|const|value|options|extpgm|extproc|export|import|static|based|overlay|pos|extname|extfld|usage|keyed|rename|prefix|ccsid|nomain|main|dftactgrp|actgrp|bnddir|option|datfmt|timfmt|decedit|alwnull|text|opdesc|rtnparm|noopt|align|occurs|ascend|descend|ctdata|fromfile|tofile|perrcd|procptr|varying|reqprexp|serialize|pgminfo|thread|psds|sds|infds|infsr|indds|sfile|extdesc|extfile|extmbr|block|devid|handler|maxdev|oflind|pass|pgmname|rafdata|recno|saveds|saveind|sln|workstn|disk|printer|seq|special|charcount|nullind|samepos|dtaara)(?=\\s*\\(|\\s|;|$)",
          "name": "storage.modifier.qs400-rpgle"
        },
        {
          "match": "(?i)(?<![\\w#@$-])(?:and|or|not)(?![\\w#@$-])",
          "name": "keyword.operator.logical.qs400-rpgle"
        },
        {
          "include": "#common"
        },
        {
          "match": "\\*\\*|[-+*/=<>]",
          "name": "keyword.operator.qs400-rpgle"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.qs400-rpgle"
        }
      ]
    },
    "line-comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.qs400-rpgle"
    },
    "exec-sql": {
      "begin": "(?i)\\b(exec)\\s+(sql)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.exec-sql.qs400-rpgle"
        },
        "2": {
          "name": "keyword.control.directive.exec-sql.qs400-rpgle"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.qs400-rpgle"
        }
