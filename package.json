{
  "name": "code-for-qs400",
  "displayName": "Code for QS/400",
  "description": "Develop on QS/400: libraries, source members, the IFS, compiles and debugging, over QAP.",
  "publisher": "quartzsystems",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Quartz Systems",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartzsystems/quartz-systems-code-for-qs400"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:code-for-qs400.connections",
    "onCommand:code-for-qs400.about",
    "onCommand:code-for-qs400.host.restart"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qs400",
          "title": "QS/400",
          "icon": "media/qs400.svg"
        }
      ]
    },
    "views": {
      "qs400": [
        {
          "id": "code-for-qs400.connections",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "code-for-qs400.about",
        "title": "About",
        "category": "Code for QS/400"
      },
      {
        "command": "code-for-qs400.host.restart",
        "title": "Restart Host",
        "category": "Code for QS/400"
      },
      {
        "command": "code-for-qs400.connection.add",
        "title": "Add Connection",
        "category": "Code for QS/400",
        "icon": "$(add)"
      },
      {
        "command": "code-for-qs400.connection.edit",
        "title": "Edit Connection",
        "category": "Code for QS/400",
        "icon": "$(edit)"
      },
      {
        "command": "code-for-qs400.connection.remove",
        "title": "Remove Connection",
        "category": "Code for QS/400",
        "icon": "$(trash)"
      },
      {
        "command": "code-for-qs400.connection.connect",
        "title": "Connect",
        "category": "Code for QS/400",
        "icon": "$(plug)"
      },
      {
        "command": "code-for-qs400.connection.disconnect",
        "title": "Disconnect",
        "category": "Code for QS/400",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "code-for-qs400.connection.setDefault",
        "title": "Set as Default Connection",
        "category": "Code for QS/400",
        "icon": "$(star)"
      },
      {
        "command": "code-for-qs400.connection.forgetPassword",
        "title": "Forget Saved Password",
        "category": "Code for QS/400",
        "icon": "$(key)"
      },
      {
        "command": "code-for-qs400.connection.switchActive",
        "title": "Switch Active Connection",
        "category": "Code for QS/400",
        "icon": "$(arrow-swap)"
      }
    ],
    "configuration": {
      "title": "Code for QS/400",
      "properties": {
        "code-for-qs400.host.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a `qs400-code-host` binary. Leave empty to use the one bundled with the extension."
        },
        "code-for-qs400.connections": {
          "type": "array",
          "default": [],
          "scope": "application",
          "markdownDescription": "Saved connections. `name` is unique and is the key for the saved password and the library list. Passwords are never kept here: they go to VS Code secret storage. Edit with the **Add Connection** and **Edit Connection** commands, or here.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host",
              "user"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Unique connection name, for example QSHQ400."
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "Host name or address of the QS/400 system. The server certificate must carry this name."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "QAP port. Leave it out for the default port."
              },
              "user": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "description": "User profile to sign on as."
              },
              "tls": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "verify": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Must be `true`. QAP accepts only a verified server certificate, as QS/400 Access does; to trust a self-signed certificate, name it in `caFile`."
                  },
                  "caFile": {
                    "type": "string",
                    "description": "PEM file with certificates to trust beyond the system store: a CA, or the server certificate itself."
                  }
                }
              },
              "libraryList": {
                "type": "object",
                "additionalProperties": false,
                "markdownDescription": "Library list applied to the session job on connect. The Library list node edits it.",
                "properties": {
                  "current": {
                    "type": "string",
                    "maxLength": 10,
                    "description": "Current library."
                  },
                  "user": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 10
                    },
                    "description": "User part of the library list, in order."
                  }
                }
              }
            }
          }
        },
        "code-for-qs400.defaultConnection": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Name of the default connection: offered first when a command asks for a connection, and marked in the Connections view."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "code-for-qs400.connections",
        "contents": "No QS/400 connections yet.\n[Add Connection](command:code-for-qs400.connection.add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code-for-qs400.connection.add",
          "when": "view == code-for-qs400.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "code-for-qs400.connection.connect",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\.disconnected/",
          "group": "inline"
        },
        {
          "command": "code-for-qs400.connection.disconnect",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\.(connected|stale|connecting)/",
          "group": "inline"
        },
        {
          "command": "code-for-qs400.connection.connect",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\.(disconnected|stale)/",
          "group": "1_session@1"
        },
        {
          "command": "code-for-qs400.connection.disconnect",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\.(connected|stale|connecting)/",
          "group": "1_session@2"
        },
        {
          "command": "code-for-qs400.connection.edit",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@1"
        },
        {
          "command": "code-for-qs400.connection.setDefault",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\.[a-z]+$/",
          "group": "2_edit@2"
        },
        {
          "command": "code-for-qs400.connection.forgetPassword",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@3"
        },
        {
          "command": "code-for-qs400.connection.remove",
          "when": "view == code-for-qs400.connections && viewItem =~ /^connection\\./",
          "group": "3_remove@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "compile-tests": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src test",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "mocha": "^11.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
